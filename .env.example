# .env.example — MẪU, không chứa secret thật. Copy thành .env rồi điền.

# Token SePay Company lấy từ sepay.vn -> Tài khoản Company -> API Token
SEPAY_API_TOKEN=thay_bang_token_sepay_cua_ban

# Token bạn tự đặt để verify webhook SePay gửi tới.
# SePay sẽ gửi header: Authorization: Bearer <token này>
SEPAY_WEBHOOK_AUTH_TOKEN=tu_dat_1_chuoi_dai_ngau_nhien_vd_abc123xyz

# Số tài khoản nhận tiền (để đối chiếu, không bắt buộc nhưng nên có)
BANK_ACCOUNT_NUMBER=123456789

# Mã tham chiếu cố định cần tìm trong nội dung chuyển khoản
EXPECTED_CODE=THCSC3

# File excel dồn duy nhất (theo lựa chọn của bạn: dồn payments.xlsx)
EXCEL_OUTPUT_DIR=data/exports
EXCEL_FILE_NAME=payments.xlsx

# FastAPI
APP_PORT=8000
APP_HOST=127.0.0.1
PYTHONPATH="d:\tool_bank"
